# 运行产物（体积大、每轮变化）
# 注意：logs/ 下默认全部忽略，但跨轮知识库 opt_knowledge.json 纳入版本跟踪
# （目录级排除无法用 ! 豁免文件，故用 logs/* + 显式豁免）
logs/*
!logs/opt_knowledge.json
*.pt
*.pyc
__pycache__/
.pytest_cache/
.DS_Store

# Makefile 管理的虚拟环境
.venv/

# optimize-loop 运行时状态
scripts/optimize_loop_state.json
scripts/.ca_session_id
scripts/.opt_loop_prompt.md
scripts/.optimize_loop_stop

# 第三方 skill 库（非项目代码）
.qoder/skills/
.qoder/better-loop/

# AI 工具配置（非项目代码）
.claude/
.cursor/
.qoder/
.idea/
.aris/

# 嵌入式独立 git 仓库（非本项目代码，git add -A 会报错）
cloud-agents-console/

# LaTeX/build 瞬态（重生成即得）
docs/paper/*.aux
docs/paper/*.log
